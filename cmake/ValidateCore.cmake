function(opentlv_python_validate_core evidence features)
    if(NOT TARGET OpenTLV::tlv)
        message(FATAL_ERROR "Selected Core must provide OpenTLV::tlv")
    endif()
    get_target_property(_type OpenTLV::tlv TYPE)
    if(NOT _type STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR "Python wheels require static Core")
    endif()
    get_target_property(_includes OpenTLV::tlv INTERFACE_INCLUDE_DIRECTORIES)
    set(_configs "")
    foreach(_include IN LISTS _includes)
        if(_include MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
            set(_include "${CMAKE_MATCH_1}")
        elseif(_include MATCHES "\\$<")
            continue()
        endif()
        if(EXISTS "${_include}/tlv/config.h")
            file(REAL_PATH "${_include}/tlv/config.h" _config)
            list(APPEND _configs "${_config}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _configs)
    list(LENGTH _configs _count)
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "Selected Core must expose one public tlv/config.h")
    endif()
    list(GET _configs 0 _config)
    file(STRINGS "${_config}" _definitions REGEX "^#define OPENTLV_")
    foreach(_feature IN LISTS features)
        set(_matches "${_definitions}")
        list(FILTER _matches INCLUDE REGEX "^#define ${_feature}([ \t]|$)")
        list(LENGTH _matches _count)
        if(NOT _count EQUAL 1 OR NOT _matches STREQUAL "#define ${_feature} 1")
            message(FATAL_ERROR "Selected Core requires one enabled ${_feature} definition")
        endif()
    endforeach()
    get_filename_component(_headers "${_config}" DIRECTORY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${_config}" "${_headers}/version.h")
    file(STRINGS "${_headers}/version.h" _versions REGEX "^#define OPENTLV_VERSION_STRING ")
    string(JSON _expected_version GET "${evidence}" version)
    if(NOT _versions STREQUAL "#define OPENTLV_VERSION_STRING \"${_expected_version}\"")
        message(FATAL_ERROR "Selected Core public version differs from verified identity")
    endif()
    file(STRINGS "${_headers}/version.h" _commits REGEX "^#define OPENTLV_GIT_COMMIT_HASH ")
    if(NOT _commits MATCHES "^#define OPENTLV_GIT_COMMIT_HASH \"([0-9a-f]+)\"$")
        message(FATAL_ERROR "Selected Core has no unambiguous public commit")
    endif()
    set(_public_commit "${CMAKE_MATCH_1}")
    string(LENGTH "${_public_commit}" _length)
    string(JSON _expected_commit GET "${evidence}" commit)
    string(FIND "${_expected_commit}" "${_public_commit}" _prefix)
    if(_length LESS 7 OR NOT _prefix EQUAL 0)
        message(FATAL_ERROR "Selected Core public commit differs from verified identity")
    endif()
    message(STATUS "Python Core capabilities: all ${_config}")
endfunction()
